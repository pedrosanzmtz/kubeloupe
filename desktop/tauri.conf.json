{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kubeloupe",
  "version": "0.1.0",
  "identifier": "com.kubeloupe.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kubeloupe",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "A Lens alternative written in Rust - a Kubernetes IDE",
    "publisher": "kubeloupe"
  }
}
