{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kubeloupe",
  "version": "0.1.0",
  "identifier": "com.kubeloupe.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui-src run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui-src run build",
    "frontendDist": "ui-src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "kubeloupe",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Lens alternative written in Rust - a Kubernetes IDE",
    "publisher": "kubeloupe"
  }
}
